# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env — it is gitignored on purpose.

# Sepolia RPC endpoint (e.g. from Alchemy or Infura).
# The Alchemy URL embeds your API key, so treat the whole URL as a secret.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key of the deployer wallet (the contract's superAdmin).
# 64 hex chars, no "0x" prefix. Use a throwaway testnet wallet, never a real one.
PRIVATE_KEY=your_deployer_private_key_here

# Etherscan API key for contract verification.
ETHERSCAN_API_KEY=your_etherscan_api_key_here
